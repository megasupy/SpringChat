# Copy to the server as /etc/springchat.env (root:root, chmod 600).
# Spring Boot maps these without extra code (relaxed binding).
#
# SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_HOST:5432/springbootdb?sslmode=require
# SPRING_DATASOURCE_USERNAME=your_user
# SPRING_DATASOURCE_PASSWORD=your_password
#
# SERVER_PORT=8081
#
# Optional behind Nginx / HTTPS:
# SERVER_FORWARD_HEADERS_STRATEGY=framework
